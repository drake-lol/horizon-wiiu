# Wii U plugin (WUPS) toolchain for wiiu/testbridge: devkitPPC + wut + the Wii U Plugin System.
FROM ghcr.io/wiiu-env/devkitppc:latest
COPY --from=ghcr.io/wiiu-env/wiiupluginsystem:latest /artifacts $DEVKITPRO
COPY --from=ghcr.io/wiiu-env/libmappedmemory:latest /artifacts $DEVKITPRO
COPY --from=ghcr.io/wiiu-env/librpxloader:latest /artifacts $DEVKITPRO
WORKDIR /project
