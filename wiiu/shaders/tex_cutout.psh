; $MODE = "UniformRegister"

; $NUM_SPI_PS_INPUT_CNTL = 2

; colour input R0
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1

; texture coordinate input R1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

; $SAMPLER_VARS[0].name = "sTexture"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0

; alpha test: pixels whose texture alpha is under 0.5 are discarded (leaves, glass, plants)
; $DB_SHADER_CONTROL.KILL_ENABLE = true

00 TEX: ADDR(48) CNT(1) VALID_PIX
    0  SAMPLE R1.xyzw, R1.xy0x, t0, s0
01 ALU: ADDR(32) CNT(6)
    1  x: MUL R0.x, R0.x, R1.x
       y: MUL R0.y, R0.y, R1.y
       z: MUL R0.z, R0.z, R1.z
       w: MUL R0.w, R0.w, R1.w
    2  x: KILLGT ____, 0.5, R1.w
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
